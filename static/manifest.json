{
  "manifest_version": 3,
  "name": "WebGPU Spector",
  "version": "0.1.0",
  "description": "Capture a WebGPU frame and inspect every draw call, the image after each draw, shaders, bind groups and buffers. Off by default; enable it per site.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WebGPU Spector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
